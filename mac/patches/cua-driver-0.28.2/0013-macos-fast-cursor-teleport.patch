+fn enqueue_with_motion(
+    tx: Option<&std::sync::mpsc::SyncSender<OverlayMsg>>,
+    key: CursorKey,
+    cmd: OverlayCommand,
+    requested: &mut Option<HashMap<CursorKey, MotionConfig>>,
