+// This exact, already-public profile is Tobkiri's explicit fast policy.
+// Zero still selects Cua's normal speed-based animation. Other profiles keep
+// the existing bounded arrival path, including their dwell/spring settings.
+fn teleport_motion(motion: &MotionConfig) -> bool {
+    motion.glide_duration_ms == 1.0
+        && motion.dwell_after_click_ms == 0.0
+        && motion.spring == 1.0
+        && motion.arc_size == 0.0
+        && motion.arc_flow == 0.0
+        && motion.turn_radius == 1.0
+}
+
+fn enqueue_teleport(
+    tx: Option<&std::sync::mpsc::SyncSender<OverlayMsg>>,
+    key: &CursorKey,
+    motion: &MotionConfig,
+    x: f64,
+    y: f64,
+) -> Option<Result<(), CursorArrivalError>> {
+    if !teleport_motion(motion) {
+        return None;
+    }
+    // Reuse the existing SnapTo + tip-offset contract used by native drags.
+    // Acceptance wakes the renderer but never waits for a frame or arrival.
+    // Queue failures remain refusals before the caller's native input.
+    Some(enqueue_cursor_command(
+        tx,
+        key.clone(),
+        cursor_overlay::track_pointer_command(x, y),
+    ))
 }
 
