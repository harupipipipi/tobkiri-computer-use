+    #[test]
+    fn teleport_queue_errors_refuse_without_retrying_or_claiming_arrival() {
+        let key = "teleport-queue-errors".to_owned();
+        let fast = teleport_profile();
+        assert_eq!(
+            enqueue_teleport(None, &key, &fast, 1.0, 2.0),
+            Some(Err(CursorArrivalError::QueueUnavailable))
+        );
+        let (tx, rx) = std::sync::mpsc::sync_channel::<OverlayMsg>(1);
+        assert_eq!(
+            enqueue_teleport(Some(&tx), &key, &fast, 1.0, 2.0),
+            Some(Ok(()))
+        );
+        assert_eq!(
+            enqueue_teleport(Some(&tx), &key, &fast, 3.0, 4.0),
+            Some(Err(CursorArrivalError::QueueFull))
+        );
+        drop(rx);
+        assert_eq!(
+            enqueue_teleport(Some(&tx), &key, &fast, 5.0, 6.0),
+            Some(Err(CursorArrivalError::QueueDisconnected))
+        );
+    }
