+#[cfg(test)]
+mod hit_test_ax_press_tests {
+    use super::hit_test_ax_press_eligible;
+
+    #[test]
+    fn requires_advertised_ax_press() {
+        assert!(hit_test_ax_press_eligible(
+            &["AXPress".to_owned()],
+            Some(true)
+        ));
+        assert!(!hit_test_ax_press_eligible(
+            &["AXShowMenu".to_owned()],
+            Some(true)
+        ));
+        assert!(!hit_test_ax_press_eligible(&[], Some(true)));
+    }
+
+    #[test]
+    fn refuses_explicitly_disabled_but_allows_unreported_enabled_state() {
+        let actions = ["AXPress".to_owned()];
+        assert!(!hit_test_ax_press_eligible(&actions, Some(false)));
+        assert!(hit_test_ax_press_eligible(&actions, None));
+    }
+}
