+/// A file panel can be a separate WindowServer surface while remaining an AX
+/// sheet of the observed window. For semantic input only, prove attachment
+/// in both directions. Never infer an attachment from title or geometry.
+pub(crate) unsafe fn belongs_to_attached_sheet(
+    element: AXUIElementRef,
+    pid: i32,
+    window_id: u32,
+) -> bool {
+    let mut ancestor = CFType::wrap_under_get_rule(element as CFTypeRef);
+    for _ in 0..MAX_ANCESTRY_DEPTH {
+        let current = ancestor.as_CFTypeRef() as AXUIElementRef;
+        let role = copy_string_attr(current, "AXRole");
+        if matches!(role.as_deref(), None | Some("AXWindow" | "AXApplication")) {
+            return false;
+        }
+        let Some(parent) = copy_element_attr(current, "AXParent") else {
+            return false;
+        };
+        let parent_ref = CFType::wrap_under_create_rule(parent as CFTypeRef);
+        if role.as_deref() == Some("AXSheet") {
+            let mut owner = 0;
+            if AXUIElementGetPid(parent, &mut owner) != kAXErrorSuccess
+                || owner != pid
+                || copy_string_attr(parent, "AXRole").as_deref() != Some("AXWindow")
+                || ax_get_window_id(parent) != Some(window_id)
+            {
+                return false;
+            }
+            let contains_sheet = |children: Vec<AXUIElementRef>| {
+                // Consume all retains regardless of where the match occurs.
+                children.into_iter().fold(false, |matched, child| {
+                    let child = CFType::wrap_under_create_rule(child as CFTypeRef);
+                    matched || CFEqual(child.as_CFTypeRef(), ancestor.as_CFTypeRef()) != 0
+                })
+            };
+            return contains_sheet(copy_ax_sheets(parent)) || contains_sheet(copy_children(parent));
+        }
+        ancestor = parent_ref;
+    }
+    false
 }
 
