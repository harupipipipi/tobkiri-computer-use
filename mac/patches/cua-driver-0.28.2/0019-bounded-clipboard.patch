+#[derive(Clone)]
+struct ClipboardAccess {
+    backend: Arc<dyn ClipboardBackend>,
+    permit: Arc<Semaphore>,
+    timeout: Duration,
+}
+
+impl ClipboardAccess {
+    fn new(backend: Arc<dyn ClipboardBackend>) -> Self {
+        Self {
+            backend,
+            permit: Arc::new(Semaphore::new(1)),
+            timeout: Duration::from_secs(5),
+        }
+    }
+
+    async fn run<T: Send + 'static>(
+        &self,
+        operation: &str,
+        task: impl FnOnce(&dyn ClipboardBackend) -> Result<T, String> + Send + 'static,
+    ) -> Result<T, ToolResult> {
+        let permit = self.permit.clone().try_acquire_owned().map_err(|_| {
+            unavailable(
+                operation,
+                "a previous operation is still running; no request was sent",
+            )
+        })?;
+        let backend = self.backend.clone();
+        let mut worker = tokio::task::spawn_blocking(move || {
+            let _permit = permit;
+            task(backend.as_ref())
+        });
+        match tokio::time::timeout(self.timeout, &mut worker).await {
+            Ok(Ok(Ok(value))) => Ok(value),
+            Ok(Ok(Err(error))) => Err(unavailable(operation, error)),
+            Ok(Err(error)) => Err(unavailable(operation, format!("worker failed: {error}"))),
+            Err(_) => {
+                // Aborting only cancels work that has not yet started. A running
+                // operating-system request retains the permit until it returns.
+                worker.abort();
+                Err(unavailable(
+                    operation,
+                    "the system clipboard did not respond before the deadline; the outcome is unknown",
+                ))
+            }
+        }
+    }
 }
 
