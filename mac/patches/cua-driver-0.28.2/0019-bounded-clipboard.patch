+    #[tokio::test]
+    async fn timed_out_write_does_not_queue_another_clipboard_operation() {
+        let mut clipboard = ClipboardAccess::new(Arc::new(FakeClipboard::default()));
+        clipboard.timeout = Duration::from_millis(50);
+        let (release, wait) = std::sync::mpsc::channel();
+        let (started, entered) = tokio::sync::oneshot::channel();
+        let running = clipboard.clone();
+        let delayed = tokio::spawn(async move {
+            running
+                .run("write", move |_| {
+                    let _ = started.send(());
+                    let _ = wait.recv();
+                    Ok(())
+                })
+                .await
+        });
+        entered.await.expect("worker started");
+        assert_eq!(delayed.await.unwrap().unwrap_err().is_error, Some(true));
+        let blocked: Result<(), _> = clipboard.run("read", |_| panic!("must not queue")).await;
+        assert_eq!(blocked.unwrap_err().is_error, Some(true));
+        assert_eq!(clipboard.permit.available_permits(), 0);
+        release.send(()).unwrap();
+        assert!(
+            tokio::time::timeout(Duration::from_secs(1), clipboard.permit.acquire())
+                .await
+                .is_ok()
+        );
+    }
