diff --git a/libs/cua-driver/rust/crates/platform-macos/src/ax/exact_window_cache.rs b/libs/cua-driver/rust/crates/platform-macos/src/ax/exact_window_cache.rs
new file mode 100644
index 0000000..9ed36e1
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/ax/exact_window_cache.rs
@@ -0,0 +1,267 @@
+//! Exact AX-window references retained across macOS Space transitions.
+//!
+//! AppKit can temporarily remove an off-Space window from both `AXChildren`
+//! and `AXWindows` while the already-created AX window proxy remains live.
+//! This cache never discovers or guesses a window. It only remembers a proxy
+//! that previously mapped to an exact `(pid, CGWindowID)`, then revalidates
+//! that same identity before every reuse.
+
+use std::collections::VecDeque;
+use std::sync::{Mutex, OnceLock};
+
+use core_foundation::base::{CFRelease, CFRetain, CFTypeRef};
+
+use super::bindings::{
+    ax_get_window_id, copy_element_attr, copy_string_attr, kAXErrorSuccess, AXUIElementGetPid,
+    AXUIElementRef, AXUIElementSetMessagingTimeout,
+};
+
+const MAX_RETAINED_WINDOWS: usize = 64;
+const AX_VALIDATION_TIMEOUT_SECONDS: f32 = 2.0;
+
+type ProcessStartStamp = (u64, u64);
+
+struct CachedWindow {
+    pid: i32,
+    window_id: u32,
+    process_start: ProcessStartStamp,
+    element: usize,
+}
+
+impl Drop for CachedWindow {
+    fn drop(&mut self) {
+        if self.element != 0 {
+            unsafe { CFRelease(self.element as AXUIElementRef as CFTypeRef) };
+        }
+    }
+}
+
+fn retained_windows() -> &'static Mutex<VecDeque<CachedWindow>> {
+    static WINDOWS: OnceLock<Mutex<VecDeque<CachedWindow>>> = OnceLock::new();
+    WINDOWS.get_or_init(|| Mutex::new(VecDeque::new()))
+}
+
+fn process_start_stamp(pid: i32) -> Option<ProcessStartStamp> {
+    unsafe {
+        let mut info: libc::proc_bsdinfo = std::mem::zeroed();
+        let size = std::mem::size_of::<libc::proc_bsdinfo>() as libc::c_int;
+        let filled = libc::proc_pidinfo(
+            pid,
+            libc::PROC_PIDTBSDINFO,
+            0,
+            &mut info as *mut _ as *mut libc::c_void,
+            size,
+        );
+        (filled == size).then_some((info.pbi_start_tvsec, info.pbi_start_tvusec))
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct CachedWindowFacts {
+    same_window_server_owner: bool,
+    explicitly_off_space: bool,
+    same_process_lifetime: bool,
+    ax_pid: Option<i32>,
+    ax_window_id: Option<u32>,
+    role_is_window: bool,
+}
+
+fn cached_window_is_admissible(facts: CachedWindowFacts, pid: i32, window_id: u32) -> bool {
+    facts.same_window_server_owner
+        && facts.explicitly_off_space
+        && facts.same_process_lifetime
+        && facts.ax_pid == Some(pid)
+        && facts.ax_window_id == Some(window_id)
+        && facts.role_is_window
+}
+
+unsafe fn native_identity(element: AXUIElementRef) -> (Option<i32>, Option<u32>, bool) {
+    let _ = AXUIElementSetMessagingTimeout(element, AX_VALIDATION_TIMEOUT_SECONDS);
+    let mut native_pid: libc::pid_t = 0;
+    let pid = (AXUIElementGetPid(element, &mut native_pid) == kAXErrorSuccess)
+        .then_some(native_pid as i32);
+    let window_id = ax_get_window_id(element);
+    let role_is_window = copy_string_attr(element, "AXRole").as_deref() == Some("AXWindow");
+    (pid, window_id, role_is_window)
+}
+
+fn evict(pid: i32, window_id: u32) {
+    if let Ok(mut windows) = retained_windows().lock() {
+        windows.retain(|entry| !(entry.pid == pid && entry.window_id == window_id));
+    }
+}
+
+fn window_server_reports_exact_off_space_owner(pid: i32, window_id: u32) -> bool {
+    crate::windows::all_windows().into_iter().any(|window| {
+        window.window_id == window_id && window.pid == pid && window.on_current_space == Some(false)
+    })
+}
+
+/// Remember a freshly enumerated, exact AX window.
+///
+/// Invalid/unreadable elements are never inserted. A process start stamp is
+/// mandatory so numeric PID reuse cannot inherit the old reference.
+pub unsafe fn remember_exact_window(pid: i32, window_id: u32, element: AXUIElementRef) {
+    let Some(process_start) = process_start_stamp(pid) else {
+        return;
+    };
+    let (ax_pid, ax_window_id, role_is_window) = native_identity(element);
+    if ax_pid != Some(pid) || ax_window_id != Some(window_id) || !role_is_window {
+        evict(pid, window_id);
+        return;
+    }
+
+    CFRetain(element as CFTypeRef);
+    let replacement = CachedWindow {
+        pid,
+        window_id,
+        process_start,
+        element: element as usize,
+    };
+    let Ok(mut windows) = retained_windows().lock() else {
+        drop(replacement);
+        return;
+    };
+    windows.retain(|entry| !(entry.pid == pid && entry.window_id == window_id));
+    windows.push_back(replacement);
+    while windows.len() > MAX_RETAINED_WINDOWS {
+        windows.pop_front();
+    }
+}
+
+/// Return a retained exact AX window only for an explicitly off-Space target.
+///
+/// The caller owns one retain and must `CFRelease` it. Current-Space,
+/// unknown-Space, closed, foreign-owner, relaunched-process, stale-AX, and
+/// identity-mismatch cases evict the entry and fail closed.
+pub unsafe fn cached_exact_window(pid: i32, window_id: u32) -> Option<AXUIElementRef> {
+    let exact_off_space_owner = window_server_reports_exact_off_space_owner(pid, window_id);
+    let observed_start = process_start_stamp(pid);
+
+    let (element, cached_start) = {
+        let mut windows = retained_windows().lock().ok()?;
+        let index = windows
+            .iter()
+            .position(|entry| entry.pid == pid && entry.window_id == window_id)?;
+        let entry = windows.remove(index)?;
+        let element = entry.element as AXUIElementRef;
+        let cached_start = entry.process_start;
+        CFRetain(element as CFTypeRef);
+        // Successful lookups refresh LRU order; time alone never rejects a
+        // still-live, exactly revalidated off-Space window.
+        windows.push_back(entry);
+        (element, cached_start)
+    };
+
+    let (ax_pid, ax_window_id, role_is_window) = native_identity(element);
+    let admissible = cached_window_is_admissible(
+        CachedWindowFacts {
+            same_window_server_owner: exact_off_space_owner,
+            explicitly_off_space: exact_off_space_owner,
+            same_process_lifetime: observed_start == Some(cached_start),
+            ax_pid,
+            ax_window_id,
+            role_is_window,
+        },
+        pid,
+        window_id,
+    );
+    if admissible {
+        Some(element)
+    } else {
+        CFRelease(element as CFTypeRef);
+        evict(pid, window_id);
+        None
+    }
+}
+
+/// Resolve an exact window from application-level references, then the retained
+/// off-Space cache.
+///
+/// `AXFocusedWindow` and `AXMainWindow` sometimes remain available when both
+/// top-level arrays are empty. They are admitted only after the same native
+/// pid/CGWindowID/role checks and a fresh WindowServer owner check; a sibling
+/// reference is simply ignored.
+pub unsafe fn resolve_exact_window_fallback(
+    app: AXUIElementRef,
+    pid: i32,
+    window_id: u32,
+) -> Option<AXUIElementRef> {
+    let explicitly_off_space = window_server_reports_exact_off_space_owner(pid, window_id);
+    if !explicitly_off_space {
+        evict(pid, window_id);
+        return None;
+    }
+    for attribute in ["AXFocusedWindow", "AXMainWindow"] {
+        let Some(window) = copy_element_attr(app, attribute) else {
+            continue;
+        };
+        let (ax_pid, ax_window_id, role_is_window) = native_identity(window);
+        if ax_pid == Some(pid) && ax_window_id == Some(window_id) && role_is_window {
+            remember_exact_window(pid, window_id, window);
+            return Some(window);
+        }
+        CFRelease(window as CFTypeRef);
+    }
+    cached_exact_window(pid, window_id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{cached_window_is_admissible, CachedWindowFacts};
+
+    fn exact() -> CachedWindowFacts {
+        CachedWindowFacts {
+            same_window_server_owner: true,
+            explicitly_off_space: true,
+            same_process_lifetime: true,
+            ax_pid: Some(42),
+            ax_window_id: Some(99),
+            role_is_window: true,
+        }
+    }
+
+    #[test]
+    fn only_exact_live_off_space_identity_is_admitted() {
+        assert!(cached_window_is_admissible(exact(), 42, 99));
+    }
+
+    #[test]
+    fn closed_foreign_current_or_unknown_space_is_refused() {
+        for mutate in [
+            |facts: &mut CachedWindowFacts| facts.same_window_server_owner = false,
+            |facts: &mut CachedWindowFacts| facts.explicitly_off_space = false,
+        ] {
+            let mut facts = exact();
+            mutate(&mut facts);
+            assert!(!cached_window_is_admissible(facts, 42, 99));
+        }
+    }
+
+    #[test]
+    fn pid_reuse_and_every_ax_identity_failure_are_refused() {
+        let mut variants = Vec::new();
+        let mut facts = exact();
+        facts.same_process_lifetime = false;
+        variants.push(facts);
+        let mut facts = exact();
+        facts.ax_pid = Some(7);
+        variants.push(facts);
+        let mut facts = exact();
+        facts.ax_pid = None;
+        variants.push(facts);
+        let mut facts = exact();
+        facts.ax_window_id = Some(100);
+        variants.push(facts);
+        let mut facts = exact();
+        facts.ax_window_id = None;
+        variants.push(facts);
+        let mut facts = exact();
+        facts.role_is_window = false;
+        variants.push(facts);
+
+        for facts in variants {
+            assert!(!cached_window_is_admissible(facts, 42, 99));
+        }
+    }
+}
