+#[cfg(test)]
+mod single_pid_drag_route_tests {
+    use super::{post_single_pid_route, SinglePostRoute};
+    use std::cell::Cell;
+
+    #[test]
+    fn skylight_success_posts_exactly_once_without_public_duplicate() {
+        let private_calls = Cell::new(0);
+        let public_calls = Cell::new(0);
+
+        let route = post_single_pid_route(
+            || {
+                private_calls.set(private_calls.get() + 1);
+                true
+            },
+            || public_calls.set(public_calls.get() + 1),
+        );
+
+        assert_eq!(route, SinglePostRoute::SkyLight);
+        assert_eq!(private_calls.get(), 1);
+        assert_eq!(public_calls.get(), 0);
+    }
+
+    #[test]
+    fn missing_skylight_uses_exactly_one_public_pid_post() {
+        let private_calls = Cell::new(0);
+        let public_calls = Cell::new(0);
+
+        let route = post_single_pid_route(
+            || {
+                private_calls.set(private_calls.get() + 1);
+                false
+            },
+            || public_calls.set(public_calls.get() + 1),
+        );
+
+        assert_eq!(route, SinglePostRoute::Public);
+        assert_eq!(private_calls.get(), 1);
+        assert_eq!(public_calls.get(), 1);
+    }
+
+    #[test]
+    fn drag_sequence_posts_one_transport_call_per_native_event() {
+        let private_calls = Cell::new(0);
+        let public_calls = Cell::new(0);
+        let native_event_count = 7; // down + five dragged events + up
+
+        for _ in 0..native_event_count {
+            let route = post_single_pid_route(
+                || {
+                    private_calls.set(private_calls.get() + 1);
+                    true
+                },
+                || public_calls.set(public_calls.get() + 1),
+            );
+            assert_eq!(route, SinglePostRoute::SkyLight);
+        }
+
+        assert_eq!(private_calls.get(), native_event_count);
+        assert_eq!(public_calls.get(), 0);
+        assert_eq!(private_calls.get() + public_calls.get(), native_event_count,);
+    }
+}
