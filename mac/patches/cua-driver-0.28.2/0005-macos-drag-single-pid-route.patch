 #[derive(Clone, Copy)]
 enum MousePostMode {
     Both,
+    /// Deliver one event through SkyLight, using the public PID route only when
+    /// the private symbol is unavailable. A drag must use one route throughout
+    /// so a receiver that accepts both does not observe two gestures.
+    SkyLightWithPublicFallback,
     PublicOnly,
 }
 
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum SinglePostRoute {
+    SkyLight,
+    Public,
+}
+
+/// Run exactly one PID post. `private_post` returns whether the SkyLight symbol
+/// resolved and was invoked; the public route is used only when it did not.
+fn post_single_pid_route<PrivatePost, PublicPost>(
+    private_post: PrivatePost,
+    public_post: PublicPost,
+) -> SinglePostRoute
+where
+    PrivatePost: FnOnce() -> bool,
+    PublicPost: FnOnce(),
+{
+    if private_post() {
+        SinglePostRoute::SkyLight
+    } else {
+        public_post();
+        SinglePostRoute::Public
+    }
+}
