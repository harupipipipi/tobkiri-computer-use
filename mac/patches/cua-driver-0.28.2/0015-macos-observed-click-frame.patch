+/// The verified, delivered screenshot space of one observation. Convert to
+/// local logical points directly from that observation, even on scaled displays.
+#[derive(Clone)]
+pub(crate) struct ObservedPixelFrame {
+    bounds: WindowBounds,
+    width: u32,
+    height: u32,
+    title: String,
+}
+
+fn same_bounds(a: &WindowBounds, b: &WindowBounds) -> bool {
+    a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
+}
+
+impl ObservedPixelFrame {
+    pub(crate) fn bind(
+        pid: i32, wid: u32, bounds: &WindowBounds, width: u32, height: u32,
+    ) -> Option<Self> {
+        let info = crate::windows::window_info_by_id(wid)?;
+        if info.pid != pid || info.layer != 0 || !info.is_on_screen
+            || !same_bounds(bounds, &info.bounds) || width == 0 || height == 0
+        {
+            return None;
+        }
+        Some(Self { bounds: bounds.clone(), width, height, title: info.title })
+    }
+
+    pub(crate) fn resolve(
+        &self, pid: i32, wid: u32, x: f64, y: f64,
+    ) -> Result<(f64, f64, f64, f64), ToolResult> {
+        let Some(window) = crate::windows::window_info_by_id(wid) else {
+            return Err(refusal(&PxFrameError::WindowNotFound { window_id: wid }));
+        };
+        if window.pid != pid || window.layer != 0 || !window.is_on_screen
+            || window.title != self.title || !same_bounds(&self.bounds, &window.bounds)
+        {
+            return Err(ToolResult::error("The observed window frame changed; refresh the screenshot.")
+                .with_structured(serde_json::json!({"code": "stale_geometry", "effect": "refused"})));
+        }
+        self.project(x, y).ok_or_else(|| {
+            ToolResult::error("The click is outside the observed screenshot.")
+                .with_structured(serde_json::json!({"code": "invalid_point", "effect": "refused"}))
+        })
+    }
+
+    fn project(&self, x: f64, y: f64) -> Option<(f64, f64, f64, f64)> {
+        if !(0.0..self.width as f64).contains(&x) || !(0.0..self.height as f64).contains(&y) {
+            return None;
+        }
+        let lx = x * self.bounds.width / self.width as f64;
+        let ly = y * self.bounds.height / self.height as f64;
+        Some((self.bounds.x + lx, self.bounds.y + ly, lx, ly))
     }
 }
 
