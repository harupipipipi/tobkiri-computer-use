+/// Static-window replay entry point. Accepts only a current, exact native
+/// screenshot snapshot and background left-clicks. The ordinary click tool
+/// keeps its independently captured pixel-frame validation.
+pub struct ObservedClickTool(pub ClickTool);
+
+#[async_trait]
+impl Tool for ObservedClickTool {
+    fn def(&self) -> &ToolDef {
+        static OBSERVED: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+        OBSERVED.get_or_init(|| ToolDef {
+            name: "tobkiri_click_observed".into(),
+            description: "Background left click on pixels of the latest verified exact-window screenshot. For static layouts; observe again after window changes.".into(),
+            input_schema: serde_json::json!({
+                "type": "object", "additionalProperties": false,
+                "required": ["target", "snapshot_id", "x", "y"],
+                "properties": {
+                    "session": {"type": "string"},
+                    "target": {
+                        "type": "object", "additionalProperties": false,
+                        "required": ["kind", "pid", "window_id"],
+                        "properties": {
+                            "kind": {"const": "window"},
+                            "pid": {"type": "integer", "minimum": 1, "maximum": i32::MAX},
+                            "window_id": {"type": "integer", "minimum": 1, "maximum": u32::MAX}
+                        }
+                    },
+                    "snapshot_id": {"type": "string"},
+                    "x": {"type": "number", "minimum": 0},
+                    "y": {"type": "number", "minimum": 0}
+                }
+            }),
+            read_only: false, destructive: true, idempotent: false, open_world: true,
+        })
+    }
+
+    async fn invoke(&self, args: Value) -> ToolResult {
+        let target = &args["target"];
+        let snapshot_id = args["snapshot_id"].as_str().and_then(cua_driver_core::element_token::parse_snapshot_handle);
+        let pid = target["pid"].as_i64().and_then(|pid| i32::try_from(pid).ok()).filter(|pid| *pid > 0);
+        let wid = target["window_id"].as_u64().and_then(|wid| u32::try_from(wid).ok()).filter(|wid| *wid > 0);
+        let (Some(pid), Some(wid), Some(snapshot_id), Some(x), Some(y)) =
+            (pid, wid, snapshot_id, args["x"].as_f64(), args["y"].as_f64())
+        else {
+            return ToolResult::error("An exact window, screenshot snapshot_id and pixel x/y are required.");
+        };
+        if target["kind"] != "window" {
+            return ToolResult::error("Observed clicks require an exact window target.");
+        }
+        let Some(frame) = self.0.state.element_cache.snapshot_metadata(
+            pid, u64::from(wid), snapshot_id, |payload| payload.pixel_frame.clone(),
+        ) else {
+            return ToolResult::error("The screenshot snapshot expired or has no verified pixel frame.")
+                .with_structured(serde_json::json!({"code": "stale_observation", "effect": "refused"}));
+        };
+        let cursor_key = super::cursor_tools::resolve_cursor_key(&args);
+        self.0.invoke_click(serde_json::json!({
+            "pid": pid, "window_id": wid, "x": x, "y": y, "session": cursor_key,
+        }), Some(frame)).await
+    }
+}
