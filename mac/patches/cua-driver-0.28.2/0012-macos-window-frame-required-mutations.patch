+    #[test]
+    fn fixed_size_window_can_plan_a_position_only_move() {
+        let before = Frame {
+            x: 10.0,
+            y: 20.0,
+            width: 800.0,
+            height: 600.0,
+        };
+        let requested = Frame {
+            x: 110.0,
+            y: 120.0,
+            ..before
+        };
+        let plan = required_mutations(requested, before);
+        assert_eq!(plan, &POSITION_ONLY);
+        assert_eq!(unsupported_required_mutation(plan, true, false), None);
+    }
+
+    #[test]
+    fn unsupported_actual_resize_is_rejected() {
+        let before = Frame {
+            x: 10.0,
+            y: 20.0,
+            width: 800.0,
+            height: 600.0,
+        };
+        let requested = Frame {
+            width: 900.0,
+            ..before
