+/// A PID-routed drag is safe only while both endpoints remain inside the
+/// exact window frame whose capture supplied the coordinates.  CoreGraphics
+/// accepts arbitrary screen points; without this check a stale endpoint could
+/// hit a different surface even though the events carry a window id.
+fn drag_endpoints_within_window(
+    from_local: (f64, f64),
+    to_local: (f64, f64),
+    width: f64,
+    height: f64,
+) -> bool {
+    let inside = |(x, y): (f64, f64)| {
+        x.is_finite() && y.is_finite() && x >= 0.0 && y >= 0.0 && x < width && y < height
+    };
+    width.is_finite()
+        && height.is_finite()
+        && width > 0.0
+        && height > 0.0
+        && inside(from_local)
+        && inside(to_local)
+}
