+#[cfg(test)]
+mod tests {
+    use super::drag_endpoints_within_window;
+
+    #[test]
+    fn background_drag_accepts_only_finite_in_frame_endpoints() {
+        assert!(drag_endpoints_within_window(
+            (0.0, 0.0),
+            (639.999, 479.999),
+            640.0,
+            480.0
+        ));
+        for (from, to) in [
+            ((-0.1, 10.0), (20.0, 20.0)),
+            ((10.0, 10.0), (640.1, 20.0)),
+            ((10.0, 10.0), (640.0, 20.0)),
+            ((10.0, 10.0), (20.0, 480.0)),
+            ((10.0, f64::NAN), (20.0, 20.0)),
+            ((10.0, 10.0), (f64::INFINITY, 20.0)),
+        ] {
+            assert!(!drag_endpoints_within_window(from, to, 640.0, 480.0));
+        }
+        assert!(!drag_endpoints_within_window(
+            (1.0, 1.0),
+            (2.0, 2.0),
+            0.0,
+            480.0
+        ));
+    }
