+fn merge_ax_window_record(records: &mut Vec<AxWindowRecord>, incoming: AxWindowRecord) {
+    if let Some(existing) = records
+        .iter_mut()
+        .find(|record| record.window_id == incoming.window_id)
+    {
+        // Two AX proxies for one CGWindowID can disagree transiently. Preserve
+        // a known value over an unreadable one, but fail closed on a real
+        // conflict so pointer/keyboard routes cannot be unlocked by ordering.
+        if existing.minimized_conflict || incoming.minimized_conflict {
+            existing.minimized = None;
+            existing.minimized_conflict = true;
+            return;
+        }
+        match (existing.minimized, incoming.minimized) {
+            (Some(left), Some(right)) if left != right => {
+                existing.minimized = None;
+                existing.minimized_conflict = true;
+            }
+            (known @ Some(_), None) | (None, known @ Some(_)) => {
+                existing.minimized = known;
+            }
+            _ => {}
+        }
+    } else {
+        records.push(incoming);
+    }
+}
