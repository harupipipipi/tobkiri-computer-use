+/// Map retained AX elements through `_AXUIElementGetWindow`, then release them.
+/// `AXChildren` also contains menu bars and sheets, so only its `AXWindow`
+/// rows are eligible. `AXWindows` is already window-typed by contract.
+unsafe fn extend_ax_window_records(
+    records: &mut Vec<AxWindowRecord>,
+    elements: Vec<AXUIElementRef>,
+    require_window_role: bool,
+) {
+    for window in elements {
+        let eligible = !require_window_role
+            || copy_string_attr(window, "AXRole").as_deref() == Some("AXWindow");
+        let record = eligible.then(|| {
+            ax_get_window_id(window).map(|window_id| AxWindowRecord {
                 window_id,
                 minimized: copy_bool_attr(window, "AXMinimized"),
-            });
-            CFRelease(window as CFTypeRef);
-            record
-        })
-        .collect()
+                minimized_conflict: false,
+            })
+        });
+        CFRelease(window as CFTypeRef);
+        if let Some(Some(record)) = record {
+            merge_ax_window_record(records, record);
+        }
+    }
+}
+
+/// Map the same fresh top-level union used by the AX tree walker.
+///
+/// AppKit can expose a live top-level window through `AXChildren` while a
+/// concurrent `AXWindows` read is empty (and vice versa). The observation path
+/// already unions both attributes. Applying the same exact SPI mapping here
+/// prevents an observed `(pid, CGWindowID)` from being rejected solely because
+/// the mutation gate sampled the narrower attribute. Windows whose id the SPI
+/// cannot resolve remain omitted and can never satisfy an exact-target check.
+unsafe fn ax_window_records(app: AXUIElementRef) -> Vec<AxWindowRecord> {
+    let mut records = Vec::new();
+    extend_ax_window_records(&mut records, copy_children(app), true);
+    extend_ax_window_records(&mut records, copy_ax_windows(app), false);
+    records
 }
 
